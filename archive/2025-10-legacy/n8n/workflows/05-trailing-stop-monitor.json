            },
            {
              "name": "closePosition",
              "value": "true"
            },
            {
              "name": "timestamp",
              "value": "={{Date.now() - 1000}}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-MBX-APIKEY",
              "value": "={{$env.BINANCE_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "update-trailing-sl",
      "name": "Update Trailing SL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2250, 600]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE positions SET current_stoploss = {{$json.newStopLoss}}, current_price = {{$json.currentPrice}}, last_checked_at = datetime('now') WHERE id = {{$json.id}}",
        "options": {}
      },
      "id": "update-position-db",
      "name": "Update Position DB",
      "type": "n8n-nodes-base.sqlite",
      "typeVersion": 1,
      "position": [2450, 600]
    }
  ],
