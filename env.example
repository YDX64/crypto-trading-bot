# Binance API Credentials (Get from https://testnet.binancefuture.com)
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here
BINANCE_BASE_URL=https://testnet.binancefuture.com
# For production: https://fapi.binance.com

# D28 tek-hesap/tek-yönetici kilidi. Aynı BINANCE_API_KEY ile yanlışlıkla
# ikinci bir emir motoru açılırsa ikinci süreç DB/recovery'den önce fail-closed
# durur. Shadow mode gerçek emir göndermediğinden kilidi almaz. KAPATMAYIN.
TRADING_ACCOUNT_LOCK_ENABLED=true
TRADING_ACCOUNT_LOCK_DIR=/tmp/tradingbot-account-locks

# Piyasa verisi kaynağı (D17, docs/DECISIONS.md · docs/RUNBOOK.md "Kline
# kaynağını mainnet'e alma"). Boş = bugünkü davranış: kline'lar da
# BINANCE_BASE_URL'den çekilir.
# Dolu ise SADECE public /fapi/v1/klines bu host'tan çekilir — emir, bakiye,
# pozisyon, ticker/evren taraması, exchangeInfo ve income BINANCE_BASE_URL'de
# KALIR (imza/API anahtarı bu host'a asla gitmez).
# Kullanım amacı: testnet'te işlem yaparken RSI/Bollinger/diverjans/rejim/ATR
# hesaplarını GERÇEK piyasa mumlarından üretmek (testnet mumları sapar) ve
# backtest harness'i ile canlı motoru aynı veriye oturtmak (parite).
# Kural: mainnet'te işlem yapılırken (BINANCE_BASE_URL mainnet) bu alan boş
# ya da mainnet host'u olmalıdır; testnet host'u startup'ta reddedilir.
# SCALPER_MARKET_DATA_BASE_URL=https://fapi.binance.com

# Telegram Configuration (Create bot with @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_VIP_CHANNEL_ID=your_vip_channel_id_here

# OpenAI Configuration (Get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Trading Parameters (N8n'den alındı)
ACCOUNT_BALANCE=10000
RISK_PERCENTAGE=2
FIRST_TP_PERCENTAGE=25
TRAILING_STOP_PERCENTAGE=1.5
TRAILING_PROFIT_PERCENTAGE=0.5
CHECK_INTERVAL_SECONDS=30
MARGIN_TYPE=ISOLATED
MAX_LEVERAGE=20

# Database
DATABASE_URL=sqlite:///./tradingbot.db
# For PostgreSQL: postgresql://user:password@localhost:5432/tradingbot

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Security
JWT_SECRET=your_jwt_secret_here_change_this_in_production
API_KEY=your_api_key_for_endpoints

# Risk-olayı kanalı (POST /risk-event, D10): haber/olay botlarının scalper
# girişlerini durdurup/devam ettirebildiği VEYA tüm açık pozisyonları acilen
# kapatabildiği ayrı kanal. Boş = endpoint KAPALI (503) — TV webhook
# secret'ı ile PAYLAŞILMAZ, kendi güçlü rastgele değerini üret. Ayrıntı:
# docs/INTEGRATIONS.md §3, docs/RUNBOOK.md "Risk-olayı kanalı".
RISK_EVENT_SECRET=

# Gölge modu (D14, docs/MAINNET_PLAN.md §3, docs/RUNBOOK.md "Gölge modu"): true
# iken sinyaller bugünkü gibi tüm kapılardan geçer ama emir BORSAYA GÖNDERİLMEZ
# — scalp_trades'e status=SHADOW olarak kaydedilir. Yeni parametreleri veya
# mainnet'i riske girmeden gözlemlemek için. Varsayılan false = bugünkü davranış.
SCALPER_SHADOW_MODE=false
# Gölge tekilleştirme penceresi, dakika (D14 review sonrası eklendi): aynı
# sembol bu pencere içinde ikinci kez SHADOW satırı yazmaz; ayrıca kapasite
# kapısı bu pencereyi "açık" gibi sayar. Boş/0 = SCALPER_LOSS_COOLDOWN_MINUTES'e
# (o da yoksa 60 dk'ya) düşer. Bkz. docs/RUNBOOK.md "Gölge modu".
# SCALPER_SHADOW_DEDUP_MINUTES=

# Bayat-kâr kapanışı — "STALE_TP" (D30 ADAYI, HOLDOUT REDDETTİ — VARSAYILAN
# KAPALI, ⚠️ CANLIDA AÇMAYIN). TP1'i HİÇ görmemiş pozisyon bu yaşa (saat)
# ulaştığında ve o anki ROI'si eşiğin ÜSTÜNDEYSE reduce-only MARKET ile
# kapatılır; zararda olana dokunulmaz. Seçim pencerelerinde (+339→+448, OOS
# −130→+11) umut vermişti; seçimde kullanılmamış iki holdout penceresinde
# (May 04–25: −337→−382, Haz 08–29: +71→+59) TERS çıktı ve maks. düşüş büyüdü.
# Ayarlar KAYIT ve ileri deney için buradadır (docs/DECISIONS.md D30,
# docs/EXPERIMENTS.md E11). 0 iken hiçbir kod yolu davranış değiştirmez
# (byte-for-byte aynı backtest, tests/test_golden_backtest.py).
# SCALPER_STALE_TP_HOURS=0
# SCALPER_STALE_TP_MIN_ROI_PCT=2

# Lider piyasa kapısı — "ters-gün kapısı" (D15, spec §C, docs/ARCHITECTURE.md).
# Rejim kapısından FARKLI: o sembolün KENDİ EMA50/200 trendine bakar, bu kapı
# yalnız LİDER sembole (SCALPER_MARKET_GATE_SYMBOL) bakıp kararı tüm evrene
# uygular. Varsayılan KAPALI; açmadan önce 3 rejim penceresinde backtest ŞART
# (CLAUDE.md yasak #1). İki alt-kapı bağımsız, 0 = o alt-kapı kapalı.
# SCALPER_MARKET_GATE=false
# SCALPER_MARKET_GATE_SYMBOL=BTCUSDT
# Gün-içi: lider gün açılışının ≥%X ALTINDAYSA LONG, ≥%X ÜSTÜNDEYSE SHORT yok.
# Ölçülen en iyi eşik %1.3 (E7 V1c: üç pencerede de %1.0'ı domine ediyor).
# SCALPER_MARKET_GATE_DAY_PCT=1.3
# Uzama: lider son N tamamlanmış günde ≥+%Y koştuysa LONG, ≤−%Y ise SHORT yok.
# !! UYARI: bu alt-kapıyı AÇMAYIN. İki bağımsız ölçüm desteklemiyor — E7
# (harness): yalnız ayı penceresinde, tek lider olayında tetikleniyor ve
# gün-içi kapısının üstüne katkısı YOK; E8 (canlı defter): net NEGATİF
# (−152.7) ve hipotezin işareti ters. 0 = kapalı. Bkz. docs/DECISIONS.md D15.
# SCALPER_MARKET_GATE_RUN_PCT=0
# SCALPER_MARKET_GATE_RUN_DAYS=3
# Lider verisi alınamazsa kaç saniye YENİDEN DENENMESİN (negatif önbellek).
# Yanlış lider sembolü/ağ arızasında her sinyalin boşa REST isteği açmasını ve
# KlineFetcher'ın paylaşılan kilidini tutmasını engeller. 0 = kapalı.
# SCALPER_MARKET_GATE_RETRY_SEC=60
# Kapının GERÇEKTEN koruyup korumadığı: GET /scalper/status →
# market_gate.gate_effective (enabled DEĞİL — kapı fail-open'dır).

# Piyasa yapısı (CHoCH/BOS) kapısı — D18 ADAYI, kanıt REDDETTİ, VARSAYILAN KAPALI.
# ⚠️ E9'da 7/7 varyantın hepsi P2 karar kuralında REDDEDİLDİ (docs/EXPERIMENTS.md
# E9, docs/DECISIONS.md D18). Ayarlar KAYIT için buradadır; AÇMAK yeni bir kanıt
# gerektirir (CLAUDE.md yasak #1). KAPALIYKEN hiçbir kod yolu davranış
# değiştirmez (byte-for-byte aynı backtest — tests/test_golden_backtest.py).
# SCALPER_STRUCTURE_GATE=false
# SCALPER_STRUCTURE_TF=context      # rol adı (entry|context|regime) ya da "5m"
# SCALPER_STRUCTURE_PIVOT=5         # fraktal pivot uzunluğu (her iki taraf)
# SCALPER_STRUCTURE_USE_CLOSE=true  # kırılım kapanışla onaylansın (fitil-avı eler)
# SCALPER_STRUCTURE_BLOCK_COUNTER=true   # BEAR yapıda LONG yok
# SCALPER_STRUCTURE_EXIT=off        # off | be | close (açık pozisyona TERS CHoCH)

# Genel deterministik giriş kapıları (2026-09-03) — VARSAYILAN KAPALI, post-hoc
# tarama ADAYLARI. Tarama hangi BASİT kuralın kayıp yoğunlaşmasını kestiğini
# ölçüyor; kazanan kural YALNIZ env ile açılır, canlı motor ile harness AYNI
# saf fonksiyonu (src/strategies/scalper/entry_gates.py) AYNI girdiyle uygular
# (#P1 parite, tests/test_entry_gates.py). KAPALIYKEN hiçbir kod yolu davranış
# değiştirmez (byte-for-byte aynı backtest — tests/test_golden_backtest.py).
# ⚠️ Açmadan önce 3 rejim penceresinde backtest ŞART (CLAUDE.md yasak #1);
# kanıt docs/DECISIONS.md'ye işlenmeden canlıda AÇMAYIN. Geçersiz bir değer
# (yalnız alan doluyken) startup'ta fail-fast'tır.
# 1) Rejim×yön hücresi yasağı — "REJIM:YON,..." (UP|DOWN|RANGE|UNKNOWN :
#    LONG|SHORT). Rejim kapısının (DOWN+LONG / UP+SHORT) ÜSTÜNE ek yasak;
#    sinyal doğduktan sonra çalışır, niyet defterine (cell_gate) yazar.
# SCALPER_C_BLOCKED_CELLS=
# 2) UTC saat penceresi yasağı — "0-6,22-24" (başlangıç DAHİL, bitiş HARİÇ;
#    gece yarısını saran "22-3" kabul). Saat = son KAPANMIŞ giriş mumunun
#    close_time'ı (duvar saati DEĞİL): 04:55-05:00 mumu saat 4 sayılır.
# SCALPER_ENTRY_BLOCK_HOURS_UTC=
# 3) ATR% bandı — ATR(14, giriş TF) / giriş fiyatı × 100, HAM sinyalle
#    (apply_stop_policy ÖNCESİ, dinamik kaldıraçtan bağımsız). 0 = o uç kapalı;
#    ATR% < MIN ya da > MAX → RED (eşitlik serbest); ATR ölçülemezse kapı
#    UYGULANMAZ (fail-open, loglanır). İkisi de >0 ise MIN < MAX şart.
# SCALPER_MIN_ATR_PCT=0
# SCALPER_MAX_ATR_PCT=0

# İşlem adli kaydı (D21) — YALNIZ GÖZLEM, motor davranışını DEĞİŞTİRMEZ.
# Her giriş/çıkış için "neden girildi, nasıl çıkıldı, ne ters gitti" kaydı
# scalp_trades.forensics (JSON) + logs/trades.jsonl'e yazılır; uçlar:
# /scalper/trades/{id}/forensics, /scalper/forensics/recent, .../summary.
# Kapatmak yalnız KAYDI durdurur — hiçbir kapı/boyutlama/çıkış değişmez.
# SCALPER_FORENSICS_ENABLED=true
# Kapanıştan sonra "fiyat girişe döndü mü" penceresi (dk). 0 = post-mortem
# KAPALI. Pencere DOLDUKTAN sonra hesaplanır (look-ahead değildir) ve tur
# başına EN FAZLA BİR sembol için 1 kline isteği (ağırlık 2) üretir.
# SCALPER_FORENSICS_POSTMORTEM_MIN=60
# Etiket eşikleri (bkz. src/strategies/scalper/forensics.py):
# SCALPER_FORENSICS_COUNTER_DRIFT_PCT=1.0   # ters-gün etiketi (lider % sapma)
# SCALPER_FORENSICS_RUN_PCT=5.0             # geç-giriş etiketi (çok günlük koşu)
# SCALPER_FORENSICS_STALE_SIGNAL_SEC=30     # sinyal→dolum gecikmesi eşiği
# SCALPER_FORENSICS_FEE_RATIO=0.5           # net/brüt eşiği (fee_dominated)

# Karşı-olgu defteri (D27/B) — YALNIZ GÖZLEM, YENİ REST AĞIRLIĞI SIFIR.
# REDDEDİLEN her giriş niyeti için "girilseydi mevcut TP/SL kurallarıyla ne
# olurdu" H saat sonra ölçülür ve logs/trades.jsonl'e (event=counterfactual)
# yazılır. Çözüm, tarama turunun ZATEN çektiği mumlarla yapılır; mum yoksa
# hesap ERTELENİR. Ana anahtar SCALPER_FORENSICS_ENABLED'dır (o kapalıysa bu
# defter de çalışmaz). Uç: /scalper/counterfactual (nginx beyaz listesinde
# DEĞİL — disk okur, panodan yoklanmamalı). Rapor: ledger_report --counterfactual
# SCALPER_COUNTERFACTUAL_ENABLED=true
# Ölçüm ufukları (saat, virgülle). En büyüğü simülasyon penceresidir.
# SCALPER_COUNTERFACTUAL_HORIZONS_H=1,4,8
# Bekleyen kayıt tavanı (dolarsa YENİ kayıt düşer, eskisi korunur).
# SCALPER_COUNTERFACTUAL_MAX_PENDING=500
# Aynı (sembol, yön, gerekçe) bu saniye içinde tekrarlanırsa yeni satır
# AÇILMAZ; ağırlık dup_count'ta birikir (JSONL hacim koruması).
# SCALPER_COUNTERFACTUAL_DEDUP_SEC=300
# Bu yaştan sonra hâlâ çözülemeyen kayıt düşürülür (sembol evrenden çıkmış).
# SCALPER_COUNTERFACTUAL_MAX_AGE_H=48

# AI karar katmanı (D23) — GÖLGE, "yalnız engelleyen", VARSAYILAN KAPALI.
# Motor TÜM kapılarını geçirip pozisyonu AÇTIKTAN sonra bir dil modeline "bu
# giriş alınmalı mıydı?" diye sorar; karar logs/trades.jsonl (ai_verdict) ve
# scalp_trades.forensics -> document["ai"] içine yazılır.
# SÖZLEŞME: bir KALİTE FİLTRESİDİR, güvenlik cihazı DEĞİLDİR — girişi yalnız
# ENGELLEYEBİLİR, ASLA açamaz; her arıza FAIL-OPEN'dır (giriş normal sürer).
#   off    = katman hiç örneklenmez (VARSAYILAN; sıfır çağrı, sıfır maliyet)
#   shadow = karar üretilir ve KAYDEDİLİR, motor davranışı DEĞİŞMEZ
#   active = kararın uygulanacağı faz — startup'ta REDDEDİLİR (aşağı bak)
#
# NEDEN KAPALI: bir dil modelinin hükmü de bir PARAMETRE değişikliğidir ve
# kanıtsız parametre değişikliği yasaktır (CLAUDE.md yasak #1). Önce gölge
# ölçümü, sonra D23'ün 11 go_live ölçütü (kapsama ≥%98, JSON geçerliliği ≥%99,
# engellenen kümenin ortalama PnL'i ve %95 GA ÜST sınırı <0, n_deny ≥ 50, ...).
# ⚠️ active BİLİNÇLİ olarak startup'ta ValueError'dır: kod yolu hazırdır ama
# motora KABLOLANMAMIŞTIR ve önce harness/motor paritesi (DECISIONS #P1) gerekir.
# Ayrıntı: docs/DECISIONS.md D23, docs/RUNBOOK.md "AI karar katmanını açma/kapama".
SCALPER_AI_GATE_MODE=off
# Sağlayıcı zinciri: birincil BU, sonra kalanlar sırayla (deepseek -> gemini ->
# openai). Sunucuda ANTHROPIC anahtarı YOKTUR. Anahtarı olmayan ya da
# "your_..." yer tutucusu olan sağlayıcı ATLANIR; hepsi başarısızsa
# ai_unavailable + FAIL-OPEN. Yeni pip bağımlılığı YOK (mevcut istemciler).
# SCALPER_AI_GATE_PROVIDER=deepseek
# Model adları: BOŞ = ilgili sağlayıcının genel ayarı (DEEPSEEK_MODEL /
# GEMINI_MODEL / OPENAI_MODEL). ⚠️ Gölge fazı için deepseek-chat ÖNERİLİR
# (ucuz + katı JSON'u iyi); boş bırakılırsa DEEPSEEK_MODEL=deepseek-reasoner
# devreye girer ve PAHALIDIR.
# SCALPER_AI_GATE_DEEPSEEK_MODEL=deepseek-chat
# SCALPER_AI_GATE_GEMINI_MODEL=
# SCALPER_AI_GATE_OPENAI_MODEL=
# Günlük çağrı tavanı (maliyet kaçağı koruması). Aşılırsa ai_budget_exhausted;
# sayaç UTC gün başında sıfırlanır. Katman YALNIZ pozisyona dönüşen adayları
# sorar; açılmayan aday sağlayıcıya SORULMAZ (yalnız ai_skipped satırı).
# SCALPER_AI_GATE_MAX_CALLS_PER_DAY=200
# Tek çağrının üst sınırı (sn). Motor gölgede BEKLEMEZ (kanca _entry_lock
# DIŞINDA, ateşle-unut); bu süre yalnız arka plan görevini sınırlar.
# SCALPER_AI_GATE_TIMEOUT_SEC=25
# Kararın TAZELİK penceresi (sn). Geç gelen karar ai_stale işaretlenir ve
# active fazda ASLA uygulanmaz.
# SCALPER_AI_GATE_TTL_SEC=120
# Kaçak koruması: son DENY_WINDOW kararın deny oranı bu eşiği aşarsa katman
# kendini shadow'a düşürür ve `runaway` bayrağı yanar (sıfırlama = restart).
# SCALPER_AI_GATE_DENY_RATIO_LIMIT=0.60
# SCALPER_AI_GATE_DENY_WINDOW=20
# Prompt'a giren "son N işlem" defter özeti (HAM FİYAT SERİSİ DEĞİL). REST
# ağırlığı artışı SIFIRDIR: orderbook/funding ALINMAZ, yeni Binance isteği yok.
# SCALPER_AI_GATE_RECENT_TRADES=20
# Yanıt üst sınırı (token). Şema küçüktür; büyük değer yalnız maliyet demek.
# SCALPER_AI_GATE_MAX_TOKENS=700
# Maliyet TAHMİNİ için $/MTok (birincil sağlayıcıya göre ayarla). YALNIZ
# TAHMİNDİR — fatura sağlayıcının kendi panosudur.
# SCALPER_AI_GATE_PRICE_IN_PER_MTOK=0.28
# SCALPER_AI_GATE_PRICE_OUT_PER_MTOK=0.42

# ---------------------------------------------------------------------------
# Backtest maliyet modeli (D24) — YALNIZ harness okur, canlı motor OKUMAZ
# ---------------------------------------------------------------------------
# Taker girişte aleyhte uygulanan kayma ORANI (0.0002 = %0,02). Daha önce
# backtest.py'de sabit koduydu; env'e taşınmasının tek amacı maliyet stres
# senaryosunu (`--fee-stress`) ölçülebilir kılmak. Bir ORANDIR, yüzde DEĞİL:
# 0.02 yazarsanız %2 kayma uygulanır (100× hata) ve config fail-fast patlar.
# Üst sınır 0.01 (%1). VARSAYILANI DEĞİŞTİRMEK altın backtest sayılarını
# oynatır — değiştirmeden önce docs/EXPERIMENTS.md'ye kanıt yazın.
# SCALPER_SLIPPAGE_RATE=0.0002
# ---------------------------------------------------------------------------
# AlgoPro takipçi halkası (D20, BOT_MODE=follower)
# ---------------------------------------------------------------------------
# Çalışma modu: "scalper" (varsayılan, BUGÜNKÜ davranış — scanner + strateji C
# + TV sağlaması) veya "follower" (AYRI süreç/hesap: scanner ve strateji YOK,
# giriş/çıkış yalnız AlgoPro V1.6 alarmlarından). Bilinmeyen değer startup'ta
# REDDEDİLİR. Ayrıntı: docs/DECISIONS.md D20, docs/RUNBOOK.md.
BOT_MODE=scalper

# --- GÖMÜLÜ TAKİPÇİ (D20b — TERCİH EDİLEN kurulum, kullanıcı kararı) ---
# true = AlgoPro takipçisi scalper ile AYNI süreçte, AYNI Binance testnet
# hesabında ve AYNI panoda çalışır; ayrı hesap/panel/HTTP köprüsü YOKTUR.
# Boyutlama gerçek bakiyeye DEĞİL SANAL deftere dayanır (aşağıda).
# false (varsayılan) = bugünkü davranış: takipçi yalnız ayrı halkada
# (BOT_MODE=follower) çalışır. BOT_MODE=follower ile birlikte kullanılamaz.
# FOLLOWER_EMBEDDED=true
#
# Sanal defter (yalnız gömülü modda): equity = taban + AP işlemlerinin
# gerçekleşmiş net PnL'i (DB'den; restart'a dayanıklı). Marj =
# equity × FOLLOWER_MARGIN_PCT. Gerçek bakiye bu marjı karşılamıyorsa
# giriş ATLANIR ve loglanır.
# FOLLOWER_VIRTUAL_CAPITAL_USDT=1000
#
# Takipçiye AYRILMIŞ sembol(ler) — virgüllü. Boş (varsayılan) = takipçi evreni
# FOLLOWER_SYMBOL_ALLOWLIST'tir ve hiçbir sembol scalper'dan çıkarılmaz.
# DOLU + FOLLOWER_EMBEDDED=true ise: takipçi evreni BU listedir VE bu semboller
# scalper'ın tarama evreninden + TV giriş oylamasından OTOMATİK dışlanır
# ("ana sistem o coini GÖRMEZ" — kullanıcı kararı 2026-08-23). Sembol kodda
# SABİT DEĞİLDİR; seçimi ölçüm belirler.
# FOLLOWER_SYMBOLS=<SEÇİLEN>

# --- ANA BOT (scalper halkası, :9091) tarafında doldurulur ---
# NOT: gömülü modda (FOLLOWER_EMBEDDED=true) köprüye GEREK YOKTUR — AlgoPro
# gövdesi /tv-signal'dan SÜREÇ İÇİ takipçiye teslim edilir. Aşağıdaki iki
# ayar yalnız AYRI halka (BOT_MODE=follower, :9093) kurulumu içindir.
# GERÇEK AlgoPro V1.6 gövdeleri bu adrese İLETİLİR (fire-and-forget; bağlantı
# 2 sn, okuma FOLLOWER_FORWARD_TIMEOUT_SECONDS). Boş = köprü KAPALI (bugünkü
# davranış). TV alarm URL'leri ve secret'ları DEĞİŞMEZ — tek TV girişi
# /tv-signal'da kalır. D20a: iletim kararı ?src=/TV_SOURCE_ALLOWLIST'e DEĞİL,
# GÖVDENİN katı AlgoPro tanıyıcısına dayanır (| BINANCE:… | TF: | Price: +
# başlıkta olay anahtarı). Sayaçlar: GET /follower/forwarder.
# FOLLOWER_FORWARD_URL=http://127.0.0.1:9093/follower/event

# --- HER İKİ halkada da AYNI değer olmalı (ana bot gönderir, takipçi doğrular) ---
# TV_WEBHOOK_SECRET ve RISK_EVENT_SECRET'tan AYRI, kendi güçlü rastgele değeri.
# Takipçi tarafında boş = /follower/event 503 ile KAPALI (fail-closed).
FOLLOWER_FORWARD_SECRET=
# FOLLOWER_FORWARD_TIMEOUT_SECONDS=20.0   # bir giriş 3-6 sn sürer; kısa değer sahte 'iletemedi' uyarısı üretir

# --- YALNIZ takipçi halkasının .env'inde anlamlı (BOT_MODE=follower) ---
# Evren ve olay filtreleri
# FOLLOWER_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT,ADAUSDT,LTCUSDT
# FOLLOWER_TIMEFRAME=1          # TradingView {{interval}} 1 dakikada "1" döner
# FOLLOWER_MAX_POSITIONS=4      # eşzamanlı pozisyon tavanı (sembol başına 1)
# FOLLOWER_COOLDOWN_SEC=60      # son çıkıştan sonra aynı sembole giriş kilidi
# FOLLOWER_FLIP=true            # ters sinyalde kapat + yeni yöne gir
# FOLLOWER_MIN_SCORE=0          # AlgoPro "Score" alt sınırı (0 = filtre kapalı)
# FOLLOWER_DAILY_LOSS_LIMIT_PCT=10   # SCALPER_DAILY_LOSS_LIMIT_PCT ile aynı mantık
#                                    # (gömülü modda SANAL sermayeye göre)
#
# Boyutlama (KULLANICI KARARI 2026-08-23): marj = bakiyenin %'si; kaldıraç
# volatiliteye göre:
#   lev = clamp(round(FOLLOWER_SL_MARGIN_PCT / sl_pct), FOLLOWER_LEV_MIN,
#               FOLLOWER_MAX_LEVERAGE)
# Üstüne ZORUNLU güvenlik: borsa kaldıraç dilimi (/fapi/v1/leverageBracket),
# lev × sl_pct ≤ LEV_LIQ_GUARD_PCT ve 1/lev − mmr > MMR_SAFETY_MULT × sl_pct/100.
# FOLLOWER_MARGIN_PCT=10
# FOLLOWER_SL_MARGIN_PCT=30     # "stop, marjın yüzde kaçı olsun?" — 10–50 arası
#                               # (dışı = startup HATASI). ESKİ ADI:
#                               # FOLLOWER_SL_ROI_TARGET (çalışmaya devam eder;
#                               # ikisi birden ve FARKLI verilirse startup hatası).
# FOLLOWER_LEV_MIN=3
# FOLLOWER_MAX_LEVERAGE=100     # eş anlamlısı: FOLLOWER_LEV_MAX
# FOLLOWER_LEV_LIQ_GUARD_PCT=50
# FOLLOWER_MMR_SAFETY_MULT=2.0
# FOLLOWER_BRACKET_CACHE_TTL_SECONDS=21600   # /fapi/v1/leverageBracket önbellek ömrü (6 sa)
# FOLLOWER_MIN_TP1_FEE_RATIO=1.0 # VARSAYILAN AÇIK (D20a bulgu 3). TP1 ROI'si
#                                 gidiş-dönüş komisyonun bu KATININ altındaysa
#                                 GİRİŞ YOK. Oran kaldıraçtan BAĞIMSIZDIR:
#                                 sl_pct ≥ ratio × 2 × taker × 100 / RR1
#                                 (1.0 / %0.05 / 0.5 → stop ≥ %0.20).
#                                 Taker oranı borsadan (commissionRate) okunur;
#                                 okunamazsa muhafazakâr config oranı.
#                                 0 = KAPALI (ayrı kullanıcı kararı, D20/D20a).
#
# Seviyeler: BİRİNCİL kaynak AlgoPro mesajıdır (SL/TP1/TP2/TP3). Aşağıdakiler
# YALNIZ mesajda seviye yoksa devreye giren yedek kuraldır (ve WARNING loglanır).
# FOLLOWER_SL_ATR_MULT=3.0
# FOLLOWER_ATR_LEN=14
# FOLLOWER_TP_RR1=0.5
# FOLLOWER_TP_RR2=1.0
# FOLLOWER_TP_RR3=1.5
# FOLLOWER_MIN_SL_PCT=0.02      # stop mesafesi bandı (fiyat %); dışı = giriş YOK
# FOLLOWER_MAX_SL_PCT=5.0
# FOLLOWER_MAX_SIGNAL_DRIFT_PCT=0  # 0 = TÜRETİLMİŞ varsayılan: SL mesafesinin
#                                 %50'si. Alarm fiyatı ile emir anındaki CANLI
#                                 fiyat farkı bunu aşarsa GİRİŞ YOK (D20a b.1/6)
# FOLLOWER_MAX_EVENT_AGE_SEC=20   # olay HTTP'de alındıktan sonra bu süreyi
#                                 aşarsa giriş YOK (giriş kilidi kuyruğu)
# FOLLOWER_LEVELS_LOG_PATH=state/follower_levels.jsonl   # kalibrasyon defteri
# FOLLOWER_ENTRY_HALT_PATH=state/follower_entry_halt.json
# FOLLOWER_SAFETY_INTERVAL_SECONDS=2.0
# TradingView olay kanalı (D19, docs/INTEGRATIONS.md §7, docs/RUNBOOK.md
# "TV olay kanalı"): /tv-signal gövdesinde `kind=exit|choch|trend|tp1` taşıyan
# istekler GİRİŞ OYU DEĞİLDİR — sağlamaya (TvConfluence) hiç girmez, yapı/çıkış
# olayı olarak `state/tv_events.json`e yazılır. `kind` yoksa bugünkü davranış
# birebir sürer (mevcut 49 alarm etkilenmez).
#
# Kaynak allowlist'i: bu satır YOKSA kod varsayılanı geçerlidir ve dört olay
# kaynağını zaten içerir. Satırı .env'de AÇIKÇA set ediyorsan olay kaynaklarını
# da eklemelisin. NOT (D19a): OLAY yolu allowlist'ten BAĞIMSIZDIR (istek
# TV_WEBHOOK_SECRET ile kimliklidir ve sağlamaya girmez) — eksik allowlist artık
# kanalı öldürmez, yalnız startup'ta WARNING + /scalper/status allowlist_ok=false
# üretir. Allowlist hâlâ GİRİŞ yolunun sayım korumasıdır.
# TV_SOURCE_ALLOWLIST=luxosc,luxso,algopro,botv3,tv,luxso_exit,luxso_trend,pac_choch,algopro_tp1,awaxx_scalp,awaxx_v2
# Basit TV giriş kaynağı performans karantinası (D28, CSV). Katı AlgoPro
# takipçi mesajları bundan ÖNCE gömülü takipçiye gider; `algopro` eklemek
# yalnız scalper confluence oyunu keser ve reddi karşı-olgu defterinde ölçer.
# TV_ENTRY_SOURCE_BLOCKLIST=algopro
#
# "Olay kaynağı" etiketleri (D19a bulgu A): bu listedeki bir `src` `kind=entry`
# ile GİRİŞ OYU VEREMEZ — istek 422 ile reddedilir. Bir çıkış alarmının mesajından
# `kind` belirteci düşerse (yazım hatası/iç içe JSON) istek sessizce giriş oyuna
# dönüşür ve LuxAlgo ailesi tek başına 2/2 sağlama kotasını doldurabilirdi.
# TV_EVENT_SOURCES=luxso_exit,luxso_trend,pac_choch,algopro_tp1
#
# off    = olaylar kaydedilir, motor HİÇ etkilenmez
# shadow = (VARSAYILAN) "aktif olsaydı ne olurdu" loglanır + would_block/would_exit
#          sayaçları artar; emir/stop DEĞİŞMEZ
# active = giriş kapısı (ters yapıda giriş engellenir) + çıkış tetikleyicisi
#          UYGULANIR. Yalnız gölge ölçümünden sonra (INTEGRATIONS §7.6).
SCALPER_TV_EVENTS_MODE=shadow
# Olay bu kadar dakikadan eskiyse yok sayılır (kapı ve çıkış tetiği için).
# ⚠️ 0 = PENCERE KAPALI ("süresiz taze" DEĞİL) — kanal tamamen sessizleşir.
SCALPER_TV_EVENTS_MAX_AGE_MIN=240
# active modda açık pozisyona ne yapılır: off | be | close
#   be    = stop BE'ye çekilir (mevcut BE mekanizması, yeni emir yolu yok)
#           — YALNIZ pozisyon KÂRDAYKEN (D19a bulgu B)
#   close = reduce-only MARKET kapanış (reaper/flatten ile AYNI çağrı),
#           exit_reason="TV_EVENT"
SCALPER_TV_EVENTS_EXIT=be
# `be` seçiliyken pozisyon ZARARDAYSA ne yapılır: skip | close (VARSAYILAN skip).
# Zararda BE, stop'u piyasanın TERS tarafına koymaktır → Binance -2021 →
# position_manager._emergency_close (piyasa emriyle ACİL KAPANIŞ). Yani "yalnız
# stop sıkışır, geri alınabilir" sanılan ayar fiilen kapanışa dönüşürdü.
SCALPER_TV_EVENTS_EXIT_LOSING=skip
# BE hedefinin piyasadan güvenli uzaklığı (%, tek yönlü pay): fiyat BE'ye bu
# paydan yakınsa "kârda" sayılmaz ve stop taşınmaz (tick/spread gürültüsü).
SCALPER_TV_EVENTS_BE_MARGIN_PCT=0.05
# Yapı durumunu KARARA sokan kaynaklar (diğerleri yalnız telemetride görünür).
# ⚠️ Boş = HİÇBİR KAYNAK karar vermez ("tüm kaynaklar" DEĞİL); MODE=active iken
# boş bırakmak startup'ta ValueError'dır (sessiz ölü kapı olmasın).
SCALPER_TV_EVENTS_GATE_SOURCES=pac_choch,luxso_trend
# Olay defterinin restart'a dayanıklı durum dosyası (atomik yazım). Bozuk dosya
# = boş durum + WARNING (fail-OPEN — risk-olayı halt'ının fail-CLOSED'ıyla
# KARIŞTIRMA). Halkalar AYRI dosya kullanmalı: her halka kendi çalışma
# dizinindedir, bu yüzden göreli varsayılan zaten ayrışır.
# ⚠️ Dosyayı SİLMEK çalışan süreci temizlemez (RAM otoritedir) — doğru reçete
# POST /tv-events/reset ya da restart (docs/RUNBOOK.md "TV olay kanalı" adım 5).
# TV_EVENTS_STATE_PATH=state/tv_events.json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Queue & Rate Limiting
MAX_POSITIONS=5
OPENAI_RATE_LIMIT_SECONDS=3.0
BINANCE_RATE_LIMIT_SECONDS=0.5
SIGNAL_QUEUE_DELAY_SECONDS=2.0

# REST ağırlık geri çekilmesi (D22) — VARSAYILAN KAPALI (0/0).
# X-MBX-USED-WEIGHT-1M bu eşiklere ulaşınca kritik OLMAYAN istekler (pano
# beslemeleri, periyodik hesap özeti, evren taraması, teşhis) takvim dakikası
# dolana kadar gönderilmez; emir/koruma/kapanış doğrulaması her zaman geçer.
#
# KAPALI OLMASININ GEREKÇESİ ÖLÇÜMDÜR: testnet'te bu başlık IP GENELİ bir
# sayaçtır ve 2026-08-23 ölçümünde günün MEDYANI 2373 idi. 2000/2300 ile açık
# olsaydı tarama turu kalıcı dururdu (bot hiç işlem açmazdı). Önce
# /scalper/status.rest_weight telemetrisiyle KENDİ IP'nin dağılımını ölç,
# sonra eşiği medyanın belirgin ÜSTÜNE koy (docs/RUNBOOK.md).
BINANCE_WEIGHT_SOFT_LIMIT=0
BINANCE_WEIGHT_HARD_LIMIT=0

# Database Password (for docker-compose)
# DB_PASSWORD yalnız docker-compose içindir; Settings ekstra anahtar kabul etmez (.env'e KOYMA)
# DB_PASSWORD=changeme_in_production

# Note: Remove duplicate entries below - use the configuration section at the top of this file
# Keeping this section for reference only - DO NOT use these values

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# DeepSeek (Settings zorunlu alan; kullanılmıyorsa yer tutucu bırak)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
